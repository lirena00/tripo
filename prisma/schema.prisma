generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  googleSub    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  trips        Trip[]    @relation("TripCreator")
  members      Member[]  @relation("MemberUser")
}

model Trip {
  id          String    @id @default(cuid())
  name        String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  creator     User      @relation("TripCreator", fields: [createdById], references: [id])
  members     Member[]
  expenses    Expense[]
  payments    Payment[]
}

model Member {
  id        String    @id @default(cuid())
  tripId    String
  name      String
  userId    String?   @unique
  upiId     String?
  createdAt DateTime  @default(now())
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User?     @relation("MemberUser", fields: [userId], references: [id])
  paidExpenses Expense[] @relation("ExpensePayer")
  shares    ExpenseShare[]
  paymentsFrom Payment[] @relation("PaymentFrom")
  paymentsTo   Payment[] @relation("PaymentTo")

  @@unique([tripId, name])
  @@index([tripId])
}

model Expense {
  id          String         @id @default(cuid())
  tripId      String
  paidById    String
  amountPaise Int
  category    String
  description String?
  createdAt   DateTime       @default(now())
  trip        Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy      Member         @relation("ExpensePayer", fields: [paidById], references: [id])
  shares      ExpenseShare[]
}

model ExpenseShare {
  id         String   @id @default(cuid())
  expenseId  String
  memberId   String
  sharePaise Int
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([expenseId, memberId])
  @@index([expenseId])
  @@index([memberId])
}

model Payment {
  id            String   @id @default(cuid())
  tripId        String
  fromMemberId  String
  toMemberId    String
  amountPaise   Int
  createdAt     DateTime @default(now())
  trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromMember    Member   @relation("PaymentFrom", fields: [fromMemberId], references: [id])
  toMember      Member   @relation("PaymentTo", fields: [toMemberId], references: [id])

  @@index([tripId])
  @@index([fromMemberId])
  @@index([toMemberId])
}